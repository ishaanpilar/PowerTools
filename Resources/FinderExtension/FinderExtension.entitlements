<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App extensions must be sandboxed. The one exception is the folder the
	     extension shares with the app: it reads the menu the app publishes
	     there and drops the requests the app picks up. build.sh rewrites the
	     path for the Developer variant's bundle id; FinderActionsSupport
	     .sandboxExceptionPath builds the same string. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/com.powertools.utils/FinderMenu/</string>
	</array>
</dict>
</plist>
